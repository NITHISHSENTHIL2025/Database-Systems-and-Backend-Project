PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_IDLE_DAYS=3
TRUSTED_DEVICE_DAYS=30

ADMIN_NAME="GymFit Admin"
ADMIN_EMAIL="admin@gymfit.local"
ADMIN_PASSWORD="change-this-password"
# Optional: set a known six-digit admin key for your review. Leave blank to generate one.
ADMIN_LOGIN_KEY=

CASHFREE_MODE=sandbox
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_API_VERSION="2025-01-01"

FRONTEND_URL="http://127.0.0.1:5173"
PUBLIC_API_URL=""
AI_ENGINE=rules
APP_TIMEZONE="Asia/Kolkata"

BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="GymFit"

FACE_MATCH_THRESHOLD=0.52
FACE_AMBIGUITY_GAP=0.07
